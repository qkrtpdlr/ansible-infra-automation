#---------------------------------------------------------------------
# HAProxy Configuration - Load Balancer
# Generated by Ansible
#---------------------------------------------------------------------

global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    daemon
    stats socket /var/lib/haproxy/stats

defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option                  http-server-close
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

#---------------------------------------------------------------------
# HAProxy Statistics Dashboard
#---------------------------------------------------------------------
listen stats
    bind *:8404
    mode http
    stats enable
    stats uri /stats
    stats realm HAProxy\ Statistics
    stats auth admin:admin123
    stats refresh 30s

#---------------------------------------------------------------------
# Frontend Configuration
#---------------------------------------------------------------------
frontend http_front
    bind *:80
    default_backend http_back
    
    # ACL for WordPress
    acl is_wordpress hdr(host) -i wordpress.example.com
    use_backend http_back if is_wordpress

#---------------------------------------------------------------------
# Backend Configuration - Round Robin Load Balancing
#---------------------------------------------------------------------
backend http_back
    balance roundrobin
    option httpchk GET /
    http-check expect status 200
    
{% for host in groups['webservers'] %}
    server {{ host }} {{ hostvars[host]['ansible_host'] }}:80 check inter 5s rise 2 fall 3
{% endfor %}
