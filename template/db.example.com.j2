$TTL    604800
@       IN      SOA     ns1.example.com. admin.example.com. (
                              2024103101         ; Serial
                              604800             ; Refresh
                              86400              ; Retry
                              2419200            ; Expire
                              604800 )           ; Negative Cache TTL
