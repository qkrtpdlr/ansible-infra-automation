<VirtualHost *:80>
    ServerName www.example.com
    DocumentRoot /srv/web/web02
    
    <Directory /srv/web/web02>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    
    ErrorLog /var/log/httpd/web02_80_error.log
    CustomLog /var/log/httpd/web02_80_access.log combined
</VirtualHost>
