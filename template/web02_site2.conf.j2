<VirtualHost *:8080>
    ServerName web02.example.com
    DocumentRoot /srv/web/web02
    
    <Directory /srv/web/web02>
        Options Indexes FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>
    
    ErrorLog /var/log/httpd/web02_8080_error.log
    CustomLog /var/log/httpd/web02_8080_access.log combined
</VirtualHost>
